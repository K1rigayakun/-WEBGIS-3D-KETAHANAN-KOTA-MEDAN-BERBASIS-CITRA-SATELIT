",children:"Brilliantly"})]}),(0,s.jsx)("p",{className:"text-lg text-[var(--text-muted)] max-w-2xl mx-auto",children:"Powerful AI writing tools designed to help you create better content, faster than ever before."})]}),(0,s.jsx)("div",{className:"grid md:grid-cols-2 lg:grid-cols-3 gap-6",children:l.map((e,t)=>(0,s.jsxs)("div",{className:"card card-hover p-6 cursor-pointer",children:[(0,s.jsx)("div",{className:"w-12 h-12 rounded-xl bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)] mb-4",children:e.icon}),(0,s.jsx)("h3",{className:"text-lg font-semibold text-[var(--text)] mb-2",children:e.title}),(0,s.jsx)("p",{className:"text-[var(--text-muted)] text-sm leading-relaxed",children:e.description})]},t))})]})})}let o=[{id:"marketing",title:"Marketing Copy",icon:(0,s.jsx)("svg",{className:"w-5 h-5",fill:"none",viewBox:"0 0 24 24",stroke:"currentColor",children:(0,s.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",strokeWidth:2,d:"M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"})}),description:"Create compelling ad copy, landing pages, and marketing emails that convert.",examples:["Facebook & Google Ads","Email Campaigns","Landing Page Copy","Product Descriptions"],preview:{input:"Write a Facebook ad for a fitness app",output:"🏋️ Transform your body in just 15 minutes a day!\n\nTired of complicated workout routines? FitPro makes fitness simple.\n\n✅ Personalized workouts\n✅ No equipment needed\n✅ Track your progress\n\nJoin 500K+ users who've already transformed their lives.\n\n👉 Download FREE today!"}},{id:"blog",title:"Blog & Articles",icon:(0,s.jsx)("svg",{className:"w-5 h-5",fill:"none",viewBox:"0 0 24 24",stroke:"currentColor",children:(0,s.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",strokeWidth:2,d:"M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"})}),description:"Generate SEO-optimized blog posts, articles, and long-form content effortlessly.",examples:["Blog Posts","How-to Guides","Listicles","Industry Reports"],preview:{input:"Write an intro for a blog about remote work tips",output:"The remote work revolution isn't just a trend—it's the new normal. With over 70% of professionals now working from home at least part-time, mastering the art of remote productivity has never been more crucial.\n\nBut let's be honest: working from your couch sounds great until you realize you've been in the same pajamas for three days. In this guide, we'll share 10 battle-tested strategies that top remote workers use to stay focused, motivated, and—most importantly—sane."}},{id:"social",title:"Social Media",icon:(0,s.jsx)("svg",{className:"w-5 h-5",fill:"none",viewBox:"0 0 24 24",stroke:"currentColor",children:(0,s.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",strokeWidth:2,d:"M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"})}),description:"Craft engaging social media posts that drive engagement and grow your audience.",examples:["Twitter/X Threads","LinkedIn Posts","Instagram Captions","TikTok Scripts"],preview:{input:"Write a LinkedIn post about AI in business",output:"AI isn't replacing jobs. It's replacing tasks.\n\nHere's what I've learned after implementing AI tools across 3 departments:\n\n→ Marketing: 40% faster content creation\n→ Sales: 2x more qualified leads\n→ Support: 60% reduction in response time\n\nThe companies winning with AI aren't the ones with the biggest budgets.\n\nThey're the ones asking: \"What repetitive tasks can we automate so our team can focus on what humans do best?\"\n\nWhat's one task you'd love to automate? 👇"}},{id:"email",title:"Email Writing",icon:(0,s.jsx)("svg",{className:"w-5 h-5",fill:"none",viewBox:"0 0 24 24",stroke:"currentColor",children:(0,s.jsx)("path",{strok